# ─────────────────────────────────────────────────────────
# DubaiNest AgentCore · .gitignore
# ─────────────────────────────────────────────────────────

# ── Environment & secrets ────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
.aws/
.secrets/

# ── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.eggs/
build/
dist/
develop-eggs/
.installed.cfg
*.manifest
*.spec

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Testing & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Jupyter
.ipynb_checkpoints

# ── Node / Angular ───────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Angular build outputs
/frontend/dist/
/frontend/tmp/
/frontend/out-tsc/
/frontend/bazel-out/
.angular/cache/
.angular/

# ── CDK / Terraform / IaC ────────────────────────────────
# CDK
cdk.out/
cdk.context.json
*.d.ts.map
infra/node_modules/
# CDK compiled TypeScript output — ts-node compiles from .ts at runtime
infra/lib/*.js
infra/lib/*.d.ts
infra/bin/*.js
infra/bin/*.d.ts
# CDK deploy artifacts
infra/cdk-outputs.json
scripts/deploy_log.txt

# Terraform (in case you swap later)
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform/
.terraform.lock.hcl

# ── AWS / SAM ────────────────────────────────────────────
.aws-sam/
samconfig.toml

# ── Docker ───────────────────────────────────────────────
.docker/

# ── Local data / vector DB ───────────────────────────────
# vector index built by scripts/build_index.py (published to S3, not git)
*.npz
*.sqlite
*.db

# ── Logs ─────────────────────────────────────────────────
logs/
*.log
*.log.*

# ── IDE / editor ─────────────────────────────────────────
.vscode/
!.vscode/settings.json.example
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.project
.classpath
.settings/

# ── OS files ─────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# ── Misc ─────────────────────────────────────────────────
*.bak
*.tmp
*.temp
.cache/
nohup.out

# Claude Code local settings
.claude/settings.local.json
evals/results/

# ── Deploy outputs (live URLs, ids): local only, never committed ──
.deploy/
