%% DubaiNest AI — System Architecture (Mermaid `architecture-beta`)
%% Cloud icons come from the iconify `logos` pack. Renders with icons on
%% https://mermaid.live (icon packs preloaded). To embed via the Mermaid API,
%% register the pack first:
%%
%%   import mermaid from 'mermaid';
%%   mermaid.registerIconPacks([{
%%     name: 'logos',
%%     loader: () => fetch('https://unpkg.com/@iconify-json/logos@1/icons.json').then(r => r.json()),
%%   }]);
%%   mermaid.initialize({ startOnLoad: true });
%%
%% Requires Mermaid v11.1+ (architecture-beta). Without icon packs the boxes
%% still render with labels — only the glyphs are omitted.

architecture-beta
    group client[Client]
    service spa(logos:angular)[Angular 17 SPA] in client

    group aws(logos:aws)[AWS Cloud]

    group edge[Edge and Delivery] in aws
    service cdn(logos:aws-cloudfront)[CloudFront] in edge
    service s3(logos:aws-s3)[S3 SPA Bundle] in edge
    service alb(logos:aws)[App Load Balancer] in edge

    group vpc[ECS Fargate] in aws
    service api(logos:fastapi)[FastAPI SSE] in vpc
    service agents(logos:python)[LangGraph Agents] in vpc
    service rag(logos:python)[ChromaDB RAG] in vpc

    group ai[AI Services] in aws
    service bedrock(logos:aws)[Bedrock Claude] in ai
    service guard(logos:aws)[Bedrock Guardrails] in ai

    group data[Data and Observability] in aws
    service ddb(logos:aws-dynamodb)[DynamoDB] in data
    service media(logos:aws-s3)[S3 plus CloudFront Media] in data
    service cw(logos:aws-cloudwatch)[CloudWatch] in data

    spa:B --> T:cdn
    s3:L --> R:cdn
    cdn:B --> T:alb
    alb:B --> T:api
    api:B --> T:agents
    agents:B --> T:rag
    agents:R --> L:bedrock
    rag:R --> L:bedrock
    bedrock:B --> T:guard
    api:R --> L:ddb
    api:R --> L:cw
    media:T --> B:cdn
