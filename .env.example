# ─────────────────────────────────────────────────────────
# DubaiNest AgentCore · .env.example
# Copy to `.env` for local dev. Never commit `.env`.
# Used by: uvicorn api.app:app --port 8000 --env-file .env
# ─────────────────────────────────────────────────────────

AWS_REGION=us-east-1
# Use your normal AWS profile/credentials; local dev calls Bedrock and reads
# the shared DynamoDB tables directly (no dynamodb-local, no ChromaDB).

# ── Shared DynamoDB tables (owned by dubainest-ai) ───────
DYNAMODB_PROPERTIES_TABLE=dubainest-properties-dev
DYNAMODB_LEADS_TABLE=dubainest-leads-dev

# ── Photos ───────────────────────────────────────────────
# Assets CloudFront domain + /media/photos. Find the domain with:
#   aws cloudformation describe-stacks --stack-name DubaiNestDataStack \
#     --query "Stacks[0].Outputs[?OutputKey=='AssetsCloudFrontDomain'].OutputValue" --output text
MEDIA_BASE_URL=https://<assets-cloudfront-domain>/media/photos

# ── Optional ─────────────────────────────────────────────
# PROPERTIES_CACHE_SECONDS=60          # how long one instance reuses its table scan
# ALLOWED_ORIGINS=http://localhost:4200
