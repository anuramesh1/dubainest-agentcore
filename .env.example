# ─────────────────────────────────────────────────────────
# DubaiNest AgentCore · .env.example
# Copy to `.env` for local dev. Never commit `.env`.
# Used by: uvicorn api.app:app --port 8000 --env-file .env
# ─────────────────────────────────────────────────────────

AWS_REGION=us-east-1
# Uses your normal AWS credentials: local dev calls Bedrock and reads/writes the
# DynamoDB tables directly (see "Prerequisites" in the README).

# ── DynamoDB tables (created once, not by CDK) ───────────
DYNAMODB_PROPERTIES_TABLE=dubainest-properties-dev
DYNAMODB_LEADS_TABLE=dubainest-leads-dev

# ── Photos (optional) ────────────────────────────────────
# Base URL the listing photo file names are appended to. Leave unset to run
# without photos.
# MEDIA_BASE_URL=https://<your-cdn-domain>/media/photos

# ── Agent ────────────────────────────────────────────────
# AGENT_MODE=local                     # chat runs the agent in the api process (AWS uses agentcore)
# LISTINGS_SOURCE=dynamodb             # or `seed` to read data/mock_properties.py
# INDEX_URI=data/listings_index.npz    # vector index from scripts/build_index.py (or s3://...)
# ROUTER_MODEL_ID=us.amazon.nova-micro-v1:0
# WRITER_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0   # the Strands agents
# WRITER_MAX_TOKENS=600
# SESSIONS_TABLE= / MEMORY_TABLE=      # unset = in-process conversation memory and profile

# ── Optional ─────────────────────────────────────────────
# PROPERTIES_CACHE_SECONDS=60          # how long one instance reuses its table scan
# ALLOWED_ORIGINS=http://localhost:4200
